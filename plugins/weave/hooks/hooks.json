{
  "description": "Weave: environment check at session start, usage events for every skill invocation, and a queued-event flush.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/doctor.py\" --quiet || true"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry.py\" flush --quiet || true",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry.py\" hook || true",
            "async": true
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^weave:",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry.py\" hook || true",
            "async": true
          }
        ]
      }
    ]
  }
}
